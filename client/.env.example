# =================================================================
# SIFTROLE MULTI-KEY LLM FAILOVER ENGINE CONFIGURATION
# =================================================================
# Siftrole automatically attempts each key in sequential order with 
# a 4-second timeout. If a key is rate-limited (HTTP 429) or offline,
# it immediately fails over to the next key. The deterministic local
# rule engine executes ONLY as the absolute last resort if all keys fail.

# 1. Groq API Keys (Llama 3.3 70B & Llama 3.1 8B)
GROQ_API_KEY_1="gsk_your_primary_groq_key"
GROQ_API_KEY_2="gsk_your_secondary_groq_key"
GROQ_API_KEY_3="gsk_your_tertiary_groq_key"
GROQ_API_KEY_4="gsk_your_fourth_groq_key"
GROQ_API_KEY_5="gsk_your_fifth_groq_key"

# Alternative: Comma-separated list of Groq keys
# GROQ_API_KEYS="gsk_key1,gsk_key2,gsk_key3,gsk_key4,gsk_key5"

# 2. Google Gemini API Keys (Gemini 1.5 Flash fallback)
# GEMINI_API_KEY_1="AIzaSyYourGeminiKey1"
# GEMINI_API_KEY_2="AIzaSyYourGeminiKey2"

# 3. OpenAI API Keys (GPT-4o-mini fallback)
# OPENAI_API_KEY_1="sk-proj-YourOpenAIKey1"

# 4. OpenRouter API Key (Multi-model router)
# OPENROUTER_API_KEY="sk-or-v1-YourOpenRouterKey"

# Database Configuration (PostgreSQL / Prisma / Neon)
DATABASE_URL="postgresql://neondb_owner:password@ep-host.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_POOLED="postgresql://neondb_owner:password@ep-host-pooler.aws.neon.tech/neondb?sslmode=require"

# Application Environment
NEXT_PUBLIC_APP_URL="https://siftrole.com"

# Email Delivery & Feedback Watchdog (Resend)
RESEND_API_KEY="re_your_resend_api_key"
FROM_EMAIL="Siftrole Feedback <onboarding@resend.dev>"
CONTACT_NOTIFICATION_EMAIL="your_email@gmail.com"
