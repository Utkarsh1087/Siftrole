# ==============================================================================
# Siftrole Express API Backend - Environment Configuration Template
# ==============================================================================

PORT=4000
NODE_ENV=production

# Neon PostgreSQL Database Connection
DATABASE_URL="postgresql://neondb_owner:password@ep-host.aws.neon.tech/neondb?sslmode=require"

# AI Summaries & Parsing Keys
GROQ_API_KEY="gsk_your_groq_key"
AI_API_KEY="gsk_your_groq_key"

# Email Delivery & SMTP (Resend)
RESEND_API_KEY="re_your_resend_api_key"
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS="re_your_resend_api_key"
FROM_EMAIL="Siftrole <onboarding@resend.dev>"

# Client CORS URL
CLIENT_URL="https://siftrole.com"
